+// NoMercy: decide whether the Metal backend registers a device at all.
+//
+// Apple Silicon is left exactly as upstream has it. On an Intel Mac the answer
+// depends on the GPU, and a wrong yes is worse than a no: without Metal 3 the
+// device has no simdgroup reduction, ggml_metal_device_supports_op() then
+// refuses the matrix products, and the graph bounces between GPU and CPU for
+// every one of them. So the default device has to report the Metal 3 family
+// (AMD Vega and the 5000/6000 series do on macOS 13 and later; Polaris, the
+// Radeon Pro 4xx/5xx and RX 580, does not).
+//
+// Intel's integrated GPUs report Metal 3 too, but nobody has measured one with
+// this backend, and they share the CPU's memory and power budget. Until
+// someone does, they stay on the CPU, which is what every release before this
+// one did on these machines.
+//
+// NOMERCY_GGML_METAL=1 takes the default device regardless, for measuring
+// exactly those GPUs. NOMERCY_GGML_GPU=0 remains the off switch.
+//
+// supportsFamily: is macOS 10.15; it is asked for first, so an older system
+// answers no instead of raising on an unknown selector.
+bool nm_ggml_metal_default_device_usable(void) {
+#if TARGET_CPU_X86_64
+    bool usable = false;
+
+    @autoreleasepool {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+
+        if (device == nil) {
+            GGML_LOG_INFO("%s: no Metal device, the CPU is used\n", __func__);
+            return false;
+        }
+
+        const char * force = getenv("NOMERCY_GGML_METAL");
+
+        if (![device respondsToSelector:@selector(supportsFamily:)]) {
+            GGML_LOG_INFO("%s: %s: this macOS cannot report the GPU family, the CPU is used\n", __func__, [[device name] UTF8String]);
+        } else if (force != NULL && strcmp(force, "1") == 0) {
+            GGML_LOG_INFO("%s: %s: taken because NOMERCY_GGML_METAL=1\n", __func__, [[device name] UTF8String]);
+            usable = true;
+        } else if (![device supportsFamily:MTLGPUFamilyMetal3_GGML]) {
+            GGML_LOG_INFO("%s: %s does not report Metal 3, the CPU is used\n", __func__, [[device name] UTF8String]);
+        } else if ([device isLowPower]) {
+            GGML_LOG_INFO("%s: %s is an integrated GPU, the CPU is used (NOMERCY_GGML_METAL=1 to try it)\n", __func__, [[device name] UTF8String]);
+        } else {
+            usable = true;
+        }
+
+        [device release];
+    }
+
+    return usable;
+#else
+    return true;
+#endif
+}
+
 ggml_metal_device_t ggml_metal_device_init(int device) {
     ggml_metal_device_t dev = calloc(1, sizeof(struct ggml_metal_device));
 
