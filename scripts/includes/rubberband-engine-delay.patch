+/* Retrieve what the stretcher has ready, drop the start delay, and send
+ * the rest on. With limit >= 0, nothing past that output length is sent. */
+static int push_output(AVFilterContext *ctx, int64_t limit)
+{
+    RubberBandContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    int avail;
+
+    while ((avail = rubberband_available(s->rbs)) > 0) {
+        AVFrame *out = ff_get_audio_buffer(outlink, avail);
+        int64_t keep;
+        int n, skip, ret;
+
+        if (!out)
+            return AVERROR(ENOMEM);
+        n = rubberband_retrieve(s->rbs, (float *const *)out->extended_data, avail);
+        skip = FFMIN(n, s->to_drop);
+        s->to_drop -= skip;
+        keep = n - skip;
+        if (limit >= 0)
+            keep = FFMIN(keep, FFMAX(limit - s->nb_samples_out, 0));
+        if (keep <= 0) {
+            av_frame_free(&out);
+            continue;
+        }
+        if (skip) {
+            for (int ch = 0; ch < s->nb_channels; ch++)
+                memmove(out->extended_data[ch], out->extended_data[ch] + skip * sizeof(float),
+                        keep * sizeof(float));
+        }
+        out->nb_samples = keep;
+        out->pts = s->first_pts + av_rescale_q(s->nb_samples_out,
+                     (AVRational){ 1, outlink->sample_rate },
+                     outlink->time_base);
+        s->nb_samples_out += keep;
+        ret = ff_filter_frame(outlink, out);
+        if (ret < 0)
+            return ret;
+    }
+    return 0;
+}
